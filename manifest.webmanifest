{
  "name": "동영상 줄이기",
  "short_name": "동영상 줄이기",
  "description": "휴대폰 동영상을 카카오톡으로 보내기 좋은 크기로 줄여 주는 간단한 도구",
  "lang": "ko",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#edf1ee",
  "theme_color": "#1d6a51",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["video/*", ".mp4", ".mov", ".m4v", ".3gp", ".webm", ".mkv"] }
      ]
    }
  }
}
